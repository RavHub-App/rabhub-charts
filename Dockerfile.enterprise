# Dockerfile.enterprise (Production Build)
# This Dockerfile merges ravhub-core and ravhub-enterprise modules to create the Enterprise Edition image.

# --- Stage 1: API Build ---
FROM node:22-slim AS build-api

WORKDIR /workspace

# Install pnpm and NestJS CLI globally
RUN npm install -g pnpm@latest @nestjs/cli

# Install system dependencies
RUN apt-get update && apt-get install -y procps postgresql-client nginx --no-install-recommends && rm -rf /var/lib/apt/lists/*

# Copy Core manifest files for caching
COPY ravhub-core/pnpm-lock.yaml ravhub-core/pnpm-workspace.yaml ravhub-core/package.json ./
COPY ravhub-core/apps/api/package.json ./apps/api/package.json
COPY ravhub-core/apps/web/package.json ./apps/web/package.json

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy Core source
COPY ravhub-core/apps/api ./apps/api
COPY ravhub-core/scripts ./scripts

# --- INJECT ENTERPRISE MODULES ---
# This part is what makes it the Enterprise Edition
COPY ravhub-enterprise ./enterprise-src

# 1. Backup Module
RUN mkdir -p apps/api/src/modules/backup && \
    cp -r enterprise-src/modules/backup/* apps/api/src/modules/backup/

# 2. License Module (Overwrites the stub in core)
RUN cp -r enterprise-src/modules/license/* apps/api/src/modules/license/

# 3. Enterprise Plugins (S3, Azure, GCS, etc.) - Skip if not present
RUN if [ -d "enterprise-src/modules/plugins/impl" ]; then \
    cp -r enterprise-src/modules/plugins/impl/* apps/api/src/modules/plugins/impl/; \
    fi

# 4. Storage Adapters (Enterprise-specific)
RUN mkdir -p apps/api/src/enterprise/storage && \
    cp -r enterprise-src/modules/storage/* apps/api/src/enterprise/storage/

# Cleanup enterprise source after injection
RUN rm -rf ./enterprise-src
# --- END INJECTION ---

# Reinstall after injection to ensure workspace packages are linked and types are available
RUN pnpm install --frozen-lockfile

# Build the API app
WORKDIR /workspace/apps/api
RUN pnpm build && npx tsc src/run-migrations.ts --outDir dist --esModuleInterop --skipLibCheck --experimentalDecorators --emitDecoratorMetadata --module commonjs --target ES2023

# Prevent duplicate migration files
RUN find dist -type f -name "*.d.ts" -delete

# Create portable deployment bundle
WORKDIR /workspace
RUN pnpm --filter=api --prod --legacy deploy /workspace/deploy/api \
	&& cp -a /workspace/apps/api/dist /workspace/deploy/api/dist


# --- Stage 2: Web Build ---
FROM node:22-slim AS build-web

WORKDIR /workspace

COPY ravhub-core/pnpm-lock.yaml ravhub-core/pnpm-workspace.yaml ravhub-core/package.json ./
COPY ravhub-core/apps/api/package.json ./apps/api/package.json
COPY ravhub-core/apps/web/package.json ./apps/web/package.json

RUN npm install -g pnpm@latest && pnpm install --frozen-lockfile

COPY ravhub-core/apps/web ./apps/web
RUN pnpm install --frozen-lockfile
RUN pnpm --filter web build


# --- Stage 3: Final Production Image ---
FROM node:22-slim

EXPOSE 3000
EXPOSE 80

WORKDIR /workspace

# Runtime dependencies
RUN apt-get update && apt-get install -y procps postgresql-client nginx --no-install-recommends \
    && npm install -g pnpm@latest \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data/storage /var/log/nginx /var/lib/nginx /workspace/api /workspace/web \
    && sed -i 's|/run/nginx.pid|/tmp/nginx.pid|g' /etc/nginx/nginx.conf \
    && sed -i 's|user www-data;|#user www-data;|g' /etc/nginx/nginx.conf \
    && chown -R node:node /workspace /data/storage /var/log/nginx /var/lib/nginx /etc/nginx/conf.d

# Copy bundles from builders
COPY --from=build-api --chown=node:node /workspace/deploy/api ./api
COPY --from=build-web --chown=node:node /workspace/apps/web/dist ./web/dist

# Nginx config
COPY --chown=node:node ravhub-core/docker/nginx/default.conf /etc/nginx/conf.d/default.conf
RUN rm -f /etc/nginx/sites-enabled/default /etc/nginx/sites-available/default || true

# Entrypoint
COPY --chown=node:node ravhub-core/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Runtime Environment
ENV NODE_ENV=production
ENV PORT=3000
ENV FRONTEND_PORT=80
ENV STORAGE_PATH=/data/storage

USER node

ENTRYPOINT ["docker-entrypoint.sh"]
